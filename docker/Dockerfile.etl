FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    "tensorflow==2.17.0" \
    "ultralytics>=8.0.0" \
    "transformers>=4.37.0" \
    "ray[default]>=2.9.0" \
    "opencv-python-headless>=4.8.0" \
    "scipy>=1.11.0" \
    "sqlalchemy>=2.0.0" \
    "psycopg2-binary>=2.9.0" \
    "boto3>=1.34.0" \
    "Pillow>=10.0.0" \
    "pyyaml>=6.0"

RUN python -c "from ultralytics import YOLO; YOLO('yolov8m.pt'); from ultralytics import RTDETR; RTDETR('rtdetr-l.pt')"

COPY src/ /app/src/
COPY configs/ /app/configs/

ENV PYTHONPATH=/app

EXPOSE 8265 6379

ENTRYPOINT [ "python", "-m", "src.cli.etl"]