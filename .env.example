# AWS Credentials for S3 sync
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 Configuration
S3_BUCKET=akhilesh-ml-checkpoints
S3_PREFIX=

# Dataset Path (local machine)
DATASET_PATH=/path/to/voc/dataset

# TensorBoard Sync Interval (seconds)
SYNC_INTERVAL=60

# Airflow Notifications
# OWNER_EMAIL: recipient address for DAG summary emails
OWNER_EMAIL=your_email@gmail.com
AIRFLOW_OWNER=your_name

# ETL Variables
ETL_LOCAL_MODE=false

# SMTP credentials (leave blank to use local Mailhog for testing)
# For Gmail: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SSL=false
SMTP_STARTTLS=true
