FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    "numpy>=1.24.0" \
    "scikit-learn>=1.3.0" \
    "sqlalchemy>=2.0.0" \
    "psycopg2-binary>=2.9.0" \
    "pyyaml>=6.0" \
    "python-dotenv"

COPY api/     /app/api/
COPY configs/ /app/configs/

ENV PYTHONPATH=/app:/app/src

ENTRYPOINT ["python", "-m", "api.services.preprocessing.clustering.cli"]